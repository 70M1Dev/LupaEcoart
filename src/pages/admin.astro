---
// ==========================================
// PANEL DE TIENDA — Lupa Ecoart
// ==========================================
// Pagina privada: la duena entra con su usuario de WordPress y una contrasena
// de aplicacion. La logica sigue siendo public/js/admin.js (script clasico);
// admin-globals.js le deja la config en el scope global antes de arrancar.
import BaseLayout from '../layouts/BaseLayout.astro';
import '../styles/admin.css';
---

<BaseLayout
    title="Panel de tienda"
    bodyClass="bg-neutral-50 text-black font-sans antialiased min-h-screen"
    cartWidget={false}
    noindex
>
    <!-- ================= LOGIN ================= -->
    <main id="view-login" class="min-h-screen flex items-center justify-center px-4 py-10 bg-primary-50" hidden>
        <form id="login-form" class="w-full max-w-sm card p-8 shadow-xl" novalidate>
            <div class="flex flex-col items-center text-center mb-6">
                <img src="/assets/logo.svg" alt="" class="h-14 w-14 mb-3">
                <h1 class="text-2xl font-light">Lupa <span class="font-semibold">Ecoart</span></h1>
                <p class="text-sm text-neutral-500">Panel de tienda</p>
            </div>

            <p id="login-demo" class="mb-4 text-xs font-semibold text-primary-800 bg-primary-100 rounded-xl px-3 py-2" hidden>
                Modo prueba: cualquier usuario entra y los cambios no tocan la tienda real.
            </p>

            <div class="space-y-4">
                <div>
                    <label for="login-user" class="label">Usuario</label>
                    <input id="login-user" class="input" autocomplete="username" autocapitalize="none" spellcheck="false" required>
                </div>
                <div>
                    <label for="login-pass" class="label">Contraseña de aplicación</label>
                    <input id="login-pass" type="password" class="input" autocomplete="current-password" required>
                    <p class="hint">Es la clave de 24 letras que se crea en WordPress, no la contraseña normal.</p>
                </div>
                <label class="flex items-center gap-2 text-sm text-neutral-700">
                    <input id="login-remember" type="checkbox" class="h-4 w-4 accent-primary-700">
                    Recordarme en este dispositivo
                </label>
            </div>

            <p id="login-error" class="mt-4 text-sm text-red-700 bg-red-50 rounded-xl px-3 py-2" role="alert" hidden></p>

            <button id="login-submit" type="submit" class="btn-primary w-full mt-6">Ingresar</button>
        </form>
    </main>

    <!-- ================= APP ================= -->
    <div id="view-app" hidden>
        <header class="bg-primary-500 text-white sticky top-0 z-40 shadow-sm">
            <div class="max-w-6xl mx-auto px-4 py-3 flex items-center gap-3">
                <img src="/assets/logo.svg" alt="" class="h-8 w-8">
                <span class="text-lg font-light tracking-wide">Lupa <span class="font-semibold">Ecoart</span></span>
                <span class="hidden sm:inline text-white/80 text-sm">· Panel</span>
                <span id="user-name" class="ml-auto hidden sm:inline text-sm text-white/90"></span>
                <a href="./" target="_blank" rel="noopener"
                   class="ml-auto sm:ml-0 px-3 py-1.5 rounded-full hover:bg-primary-600 text-sm font-medium transition">Ver tienda</a>
                <button id="logout-btn" type="button"
                        class="px-3 py-1.5 rounded-full bg-primary-700 hover:bg-primary-800 text-sm font-semibold transition">Salir</button>
            </div>
        </header>

        <nav class="bg-white border-b border-neutral-200" aria-label="Secciones del panel">
            <div class="max-w-6xl mx-auto px-4 flex gap-1" role="tablist">
                <button type="button" class="tab-btn" role="tab" data-tab="catalog" aria-selected="true">Catálogo</button>
                <button type="button" class="tab-btn" role="tab" data-tab="orders" aria-selected="false">Pedidos</button>
            </div>
        </nav>

        <!-- ---------- CATALOGO ---------- -->
        <section id="view-catalog" class="max-w-6xl mx-auto px-4 py-6">
            <div class="flex flex-wrap items-center gap-3 mb-5">
                <h1 class="text-2xl font-semibold mr-auto">Catálogo</h1>
                <button id="new-product-btn" type="button" class="btn-primary">+ Nuevo producto</button>
            </div>

            <div class="card p-3 mb-4 grid grid-cols-1 sm:grid-cols-[1fr_auto_auto] gap-3">
                <input id="filter-search" type="search" class="input" placeholder="Buscar por nombre…" aria-label="Buscar">
                <select id="filter-category" class="input sm:w-48" aria-label="Categoría">
                    <option value="">Todas las categorías</option>
                </select>
                <select id="filter-stock" class="input sm:w-40" aria-label="Stock">
                    <option value="">Todo el stock</option>
                    <option value="instock">Disponibles</option>
                    <option value="outofstock">Agotados</option>
                </select>
            </div>

            <p id="catalog-count" class="text-sm text-neutral-500 mb-3" aria-live="polite"></p>
            <div id="product-list" class="space-y-3"></div>

            <nav id="pagination" class="flex items-center justify-between mt-6" hidden>
                <button id="page-prev" type="button" class="btn-ghost">← Anterior</button>
                <span id="page-info" class="text-sm text-neutral-600"></span>
                <button id="page-next" type="button" class="btn-ghost">Siguiente →</button>
            </nav>
        </section>

        <!-- ---------- PEDIDOS ---------- -->
        <section id="view-orders" class="max-w-6xl mx-auto px-4 py-6" hidden>
            <div class="flex flex-wrap items-center gap-3 mb-5">
                <h1 class="text-2xl font-semibold mr-auto">Pedidos</h1>
                <button id="orders-refresh" type="button" class="btn-ghost">Actualizar</button>
            </div>

            <div class="card p-3 mb-4 grid grid-cols-1 sm:grid-cols-[1fr_auto] gap-3">
                <input id="orders-search" type="search" class="input" placeholder="Buscar por nombre, email o número…" aria-label="Buscar pedidos">
                <select id="orders-status" class="input sm:w-56" aria-label="Estado">
                    <option value="">Todos los estados</option>
                    <option value="processing">Procesando (pagado)</option>
                    <option value="on-hold">En espera</option>
                    <option value="pending">Pendiente de pago</option>
                    <option value="completed">Completado</option>
                    <option value="cancelled">Cancelado</option>
                    <option value="refunded">Reembolsado</option>
                    <option value="failed">Fallido</option>
                </select>
            </div>

            <p id="orders-count" class="text-sm text-neutral-500 mb-3" aria-live="polite"></p>
            <div id="orders-list" class="space-y-3"></div>

            <nav id="orders-pagination" class="flex items-center justify-between mt-6" hidden>
                <button id="orders-prev" type="button" class="btn-ghost">← Anterior</button>
                <span id="orders-page-info" class="text-sm text-neutral-600"></span>
                <button id="orders-next" type="button" class="btn-ghost">Siguiente →</button>
            </nav>
        </section>

        <!-- ---------- DETALLE DE PEDIDO ---------- -->
        <section id="view-order" class="max-w-3xl mx-auto px-4 py-6" hidden>
            <button id="order-back" type="button" class="text-sm font-medium text-primary-700 hover:underline mb-3">← Volver a pedidos</button>
            <div id="order-detail"></div>
        </section>

        <!-- ---------- EDITOR ---------- -->
        <section id="view-editor" class="max-w-3xl mx-auto px-4 py-6" hidden>
            <button id="editor-back" type="button" class="text-sm font-medium text-primary-700 hover:underline mb-3">← Volver al catálogo</button>
            <h1 id="editor-title" class="text-2xl font-semibold mb-5">Nuevo producto</h1>

            <form id="editor-form" class="space-y-5 pb-28" novalidate>
                <div class="card p-5">
                    <h2 class="font-semibold mb-1">Fotos</h2>
                    <p class="hint mb-3 !mt-0">La primera es la foto principal. Usá las flechas para cambiar el orden.</p>
                    <div id="image-grid" class="grid grid-cols-3 sm:grid-cols-4 gap-3"></div>
                </div>

                <div class="card p-5 space-y-4">
                    <h2 class="font-semibold">Datos</h2>
                    <div>
                        <label for="f-name" class="label">Nombre *</label>
                        <input id="f-name" class="input" maxlength="120" required>
                    </div>
                    <div>
                        <label for="f-category" class="label">Categoría *</label>
                        <select id="f-category" class="input" required></select>
                    </div>
                    <div>
                        <label for="f-description" class="label">Descripción</label>
                        <textarea id="f-description" class="input min-h-[120px]" rows="5"></textarea>
                        <p class="hint">Dejá una línea en blanco para separar párrafos.</p>
                    </div>
                </div>

                <div class="card p-5 grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <h2 class="font-semibold sm:col-span-2">Precio (pesos uruguayos)</h2>
                    <div>
                        <label for="f-price" class="label">Precio *</label>
                        <input id="f-price" type="number" inputmode="decimal" min="0" step="any" class="input" required>
                    </div>
                    <div>
                        <label for="f-sale" class="label">Precio de oferta</label>
                        <input id="f-sale" type="number" inputmode="decimal" min="0" step="any" class="input">
                        <p class="hint">Vacío = sin oferta.</p>
                    </div>
                </div>

                <div class="card p-5 grid grid-cols-1 sm:grid-cols-2 gap-4">
                    <h2 class="font-semibold sm:col-span-2">Stock y medidas</h2>
                    <div>
                        <label for="f-stock-mode" class="label">Stock</label>
                        <select id="f-stock-mode" class="input">
                            <option value="instock">Disponible</option>
                            <option value="outofstock">Agotado</option>
                            <option value="qty">Controlar cantidad</option>
                        </select>
                    </div>
                    <div id="f-stock-qty-wrap" hidden>
                        <label for="f-stock-qty" class="label">Unidades</label>
                        <input id="f-stock-qty" type="number" inputmode="numeric" min="0" step="1" class="input">
                        <p class="hint">Con 0 se muestra como agotado.</p>
                    </div>
                    <div class="sm:col-span-2">
                        <label for="f-sizes" class="label">Medidas</label>
                        <input id="f-sizes" class="input" placeholder="Ej: 20x30, 30x40, A4">
                        <p class="hint">Separadas por coma. Vacío si el producto tiene una sola medida.</p>
                    </div>
                </div>

                <div class="card p-5 space-y-3">
                    <h2 class="font-semibold">Visibilidad</h2>
                    <label class="flex items-start gap-3">
                        <input id="f-published" type="checkbox" class="mt-1 h-4 w-4 accent-primary-700">
                        <span><span class="font-medium">Publicado</span><br>
                            <span class="text-sm text-neutral-500">Si lo destildás queda como borrador y no se ve en la tienda.</span></span>
                    </label>
                    <label class="flex items-start gap-3">
                        <input id="f-featured" type="checkbox" class="mt-1 h-4 w-4 accent-primary-700">
                        <span><span class="font-medium">Destacado</span><br>
                            <span class="text-sm text-neutral-500">Aparece en la página de inicio.</span></span>
                    </label>
                </div>

                <p id="editor-error" class="text-sm text-red-700 bg-red-50 rounded-xl px-4 py-3" role="alert" hidden></p>

                <div class="fixed bottom-0 inset-x-0 bg-white/95 backdrop-blur-sm border-t border-neutral-200 z-30">
                    <div class="max-w-3xl mx-auto px-4 py-3 flex items-center gap-2">
                        <button id="editor-delete" type="button" class="btn-danger">Eliminar</button>
                        <button id="editor-cancel" type="button" class="btn-ghost ml-auto">Cancelar</button>
                        <button id="editor-save" type="submit" class="btn-primary">Guardar</button>
                    </div>
                </div>
            </form>
        </section>
    </div>

    <!-- ================= CONFIRMACION ================= -->
    <div id="confirm-modal" class="fixed inset-0 z-50 bg-black/40 flex items-center justify-center p-4" hidden>
        <div class="card w-full max-w-sm p-6 shadow-xl" role="dialog" aria-modal="true" aria-labelledby="confirm-title">
            <h2 id="confirm-title" class="text-lg font-semibold mb-2"></h2>
            <p id="confirm-text" class="text-sm text-neutral-600 mb-6"></p>
            <div class="flex justify-end gap-2">
                <button id="confirm-cancel" type="button" class="btn-ghost">Cancelar</button>
                <button id="confirm-ok" type="button" class="btn-primary"></button>
            </div>
        </div>
    </div>

    <div id="toasts" class="fixed bottom-20 inset-x-4 sm:left-auto sm:right-4 sm:w-96 z-[60] space-y-2"></div>
</BaseLayout>

<script>
    // admin.js es un script clasico y espera la config en el scope global, asi
    // que lo cargamos recien despues de que admin-globals.js se la deje ahi.
    // (Un <script defer> no alcanza: este modulo puede resolverse mas tarde.)
    import '../scripts/admin-globals.js';

    const el = document.createElement('script');
    el.src = '/js/admin.js?v=20260921';
    document.body.appendChild(el);
</script>
