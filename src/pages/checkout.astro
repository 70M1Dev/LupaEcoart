---
// ==========================================
// CHECKOUT — Lupa Ecoart
// ==========================================
// Navbar propia (simple, sin buscador ni carrito) para no distraer durante
// la compra. El pedido lo arma src/scripts/checkout.js con la Store API.
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Checkout" cartWidget={false}>
    <!-- ================= NAVBAR SIMPLE ================= -->
    <nav class="fixed top-0 left-0 right-0 bg-primary-500 shadow-lg z-50">
        <div class="flex items-center justify-between px-6 py-3">
            <a href="./" class="flex items-center gap-2 text-white">
                <img src="/assets/logo.svg" alt="" class="h-7 w-7">
                <span class="text-lg font-light tracking-wide">Lupa <span class="font-semibold">Ecoart</span></span>
            </a>
            <a href="carrito" class="text-white text-sm hover:underline">← Volver al carrito</a>
        </div>
    </nav>

    <!-- ================= PASOS ================= -->
    <section class="bg-primary-500 text-white pt-20 pb-8">
        <div class="container mx-auto px-4">
            <div class="flex items-center justify-center gap-2 md:gap-4 text-sm md:text-base">
                <div class="flex items-center gap-2 opacity-60">
                    <span class="w-8 h-8 rounded-full bg-primary-600 text-white flex items-center justify-center font-semibold">1</span>
                    <span class="hidden md:inline">Carrito</span>
                </div>
                <span class="opacity-50">›</span>
                <div class="flex items-center gap-2">
                    <span class="w-8 h-8 rounded-full bg-white text-primary-800 flex items-center justify-center font-bold">2</span>
                    <span class="font-semibold">Checkout</span>
                </div>
                <span class="opacity-50">›</span>
                <div class="flex items-center gap-2 opacity-60">
                    <span class="w-8 h-8 rounded-full bg-primary-600 text-white flex items-center justify-center font-semibold">3</span>
                    <span class="hidden md:inline">Confirmación</span>
                </div>
            </div>
        </div>
    </section>

    <!-- ================= CHECKOUT ================= -->
    <div class="container mx-auto px-4 py-10">
        <h1 id="checkout-title" class="text-3xl font-semibold mb-8 text-black">Finalizar compra</h1>

        <!-- Confirmación (se muestra al crear el pedido) -->
        <section id="order-success" class="hidden max-w-xl mx-auto bg-white rounded-2xl border border-primary-100 shadow-sm p-8 text-center" aria-live="polite"></section>

        <div id="checkout-grid" class="grid grid-cols-1 lg:grid-cols-3 gap-8">

            <!-- Formularios -->
            <div class="lg:col-span-2 space-y-6">

                <!-- Contacto -->
                <div class="bg-white rounded-2xl border border-primary-100 p-6">
                    <h2 class="text-xl font-semibold mb-4">Información de contacto</h2>
                    <div class="space-y-4">
                        <div>
                            <label class="block text-sm font-medium mb-2">Email *</label>
                            <input type="email" id="email" required placeholder="tu@email.com" class="field">
                        </div>
                        <div>
                            <label class="block text-sm font-medium mb-2">Teléfono *</label>
                            <input type="tel" id="phone" required placeholder="+598 99 123 456" class="field">
                        </div>
                    </div>
                </div>

                <!-- Envío -->
                <div class="bg-white rounded-2xl border border-primary-100 p-6">
                    <h2 class="text-xl font-semibold mb-4">Dirección de envío</h2>
                    <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
                        <div>
                            <label class="block text-sm font-medium mb-2">Nombre *</label>
                            <input type="text" id="first-name" required class="field">
                        </div>
                        <div>
                            <label class="block text-sm font-medium mb-2">Apellido *</label>
                            <input type="text" id="last-name" required class="field">
                        </div>
                        <div class="md:col-span-2">
                            <label class="block text-sm font-medium mb-2">Cédula / RUT *</label>
                            <input type="text" id="dni" required placeholder="Sin puntos ni guiones" class="field">
                        </div>
                        <div class="md:col-span-2">
                            <label class="block text-sm font-medium mb-2">Calle y número *</label>
                            <input type="text" id="address" required placeholder="Av. 18 de Julio 1234" class="field">
                        </div>
                        <div>
                            <label class="block text-sm font-medium mb-2">Apto / Casa</label>
                            <input type="text" id="apartment" class="field">
                        </div>
                        <div>
                            <label class="block text-sm font-medium mb-2">Código postal *</label>
                            <input type="text" id="zipcode" required class="field">
                        </div>
                        <div>
                            <label class="block text-sm font-medium mb-2">Departamento *</label>
                            <!-- Los value son los códigos de departamento de WooCommerce -->
                            <select id="state" required class="field">
                                <option value="">Seleccioná...</option>
                                <option value="UY-AR">Artigas</option>
                                <option value="UY-CA">Canelones</option>
                                <option value="UY-CL">Cerro Largo</option>
                                <option value="UY-CO">Colonia</option>
                                <option value="UY-DU">Durazno</option>
                                <option value="UY-FS">Flores</option>
                                <option value="UY-FD">Florida</option>
                                <option value="UY-LA">Lavalleja</option>
                                <option value="UY-MA">Maldonado</option>
                                <option value="UY-MO">Montevideo</option>
                                <option value="UY-PA">Paysandú</option>
                                <option value="UY-RN">Río Negro</option>
                                <option value="UY-RV">Rivera</option>
                                <option value="UY-RO">Rocha</option>
                                <option value="UY-SA">Salto</option>
                                <option value="UY-SJ">San José</option>
                                <option value="UY-SO">Soriano</option>
                                <option value="UY-TA">Tacuarembó</option>
                                <option value="UY-TT">Treinta y Tres</option>
                            </select>
                        </div>
                        <div>
                            <label class="block text-sm font-medium mb-2">Ciudad *</label>
                            <input type="text" id="city" required class="field">
                        </div>
                        <div class="md:col-span-2">
                            <label class="block text-sm font-medium mb-2">Notas para el envío (opcional)</label>
                            <textarea id="notes" rows="2" placeholder="Ej: Tocar timbre 2B" class="field"></textarea>
                        </div>
                    </div>
                </div>

                <!-- Pago -->
                <div class="bg-white rounded-2xl border border-primary-100 p-6">
                    <h2 class="text-xl font-semibold mb-4">Método de pago</h2>

                    <!-- Los métodos activos vienen de WooCommerce (js/checkout.js) -->
                    <div id="payment-methods" class="space-y-3">
                        <p class="text-sm text-neutral-500">Cargando métodos de pago…</p>
                    </div>
                </div>
            </div>

            <!-- Resumen -->
            <aside class="lg:col-span-1">
                <div class="bg-white rounded-2xl border border-primary-100 shadow-sm p-6 sticky top-24">
                    <h2 class="text-xl font-semibold mb-6 pb-4 border-b border-primary-100">Tu pedido</h2>

                    <!-- Productos (precios calculados por WooCommerce) -->
                    <div id="checkout-items" class="space-y-4 mb-6 max-h-64 overflow-y-auto">
                        <p class="text-sm text-neutral-500">Preparando tu pedido…</p>
                    </div>

                    <!-- Avisos de stock al armar el pedido -->
                    <div id="checkout-notices" class="hidden mb-4 bg-cream/60 border border-mustard/40 text-sm rounded-2xl px-4 py-3 space-y-1" role="status"></div>

                    <!-- Cupón -->
                    <div class="mb-4">
                        <div class="flex gap-2">
                            <input type="text" id="checkout-coupon" placeholder="Cupón de descuento" autocapitalize="characters"
                                   class="flex-1 min-w-0 px-4 py-2 bg-white border border-primary-100 rounded-full text-sm focus:outline-none focus:ring-2 focus:ring-primary-400">
                            <button id="checkout-coupon-btn" type="button"
                                    class="bg-primary-50 hover:bg-primary-100 text-primary-800 px-4 py-2 rounded-full text-sm font-semibold transition disabled:opacity-50">
                                Aplicar
                            </button>
                        </div>
                        <p id="checkout-coupon-message" class="text-xs mt-2 hidden"></p>
                    </div>

                    <!-- Opciones de envío -->
                    <div id="shipping-rates" class="hidden mb-4 space-y-2"></div>

                    <!-- Totales -->
                    <div class="space-y-3 mb-6 pt-4 border-t border-primary-100">
                        <div class="flex justify-between text-sm">
                            <span class="text-neutral-600">Subtotal</span>
                            <span class="font-semibold" id="checkout-subtotal">—</span>
                        </div>
                        <div id="checkout-discount-row" class="flex justify-between text-sm hidden">
                            <span class="text-neutral-600">Descuento</span>
                            <span class="font-semibold text-primary-600" id="checkout-discount">—</span>
                        </div>
                        <div class="flex justify-between text-sm">
                            <span class="text-neutral-600">Envío</span>
                            <span class="font-semibold" id="checkout-shipping">Elegí el departamento</span>
                        </div>
                    </div>

                    <div class="flex justify-between items-center pt-4 border-t border-primary-100 mb-6">
                        <span class="text-lg font-semibold">Total</span>
                        <span class="text-2xl font-bold text-black" id="checkout-total">—</span>
                    </div>

                    <p id="checkout-error" class="hidden mb-4 text-sm text-red-700 bg-red-50 rounded-2xl px-4 py-3" role="alert"></p>

                    <button id="place-order-btn" disabled
                            class="w-full bg-primary-700 hover:bg-primary-800 text-white font-semibold py-4 rounded-full transition mb-6 disabled:opacity-50 disabled:cursor-not-allowed">
                        Confirmar pedido
                    </button>

                    <div class="text-center text-xs text-neutral-500 space-y-1">
                        <p>Pago 100% seguro</p>
                        <p>Envío gratis en compras desde $ 3.000</p>
                    </div>
                </div>
            </aside>

        </div>
    </div>

</BaseLayout>

<script>
    import '../scripts/cart.js';
    import '../scripts/checkout.js';
</script>
