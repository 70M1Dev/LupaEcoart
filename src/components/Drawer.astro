---
// ==========================================
// DRAWER MOBILE — Lupa Ecoart
// ==========================================
// Navegacion lateral en pantallas chicas. Se abre con <MenuToggle />.
// La logica (abrir, cerrar, overlay, ESC) vive en src/scripts/ui.js.
import { WC_CATEGORIES } from '../scripts/categories.js';

interface Props {
    /** Lista las categorias arriba de los links (el home las muestra). */
    categories?: boolean;
    /** Bajada debajo del titulo. */
    subtitle?: string | null;
}

const { categories = false, subtitle = null } = Astro.props;
---

<div
    id="drawer-overlay"
    class="fixed inset-0 bg-primary-900/60 z-40 hidden opacity-0 transition-opacity"
>
</div>

<div
    id="drawer"
    class="fixed top-0 right-0 h-full w-72 bg-primary-800 shadow-2xl z-50 transform translate-x-full transition-transform duration-300 ease-in-out md:hidden overflow-y-auto"
>
    <!-- Header del drawer -->
    <div class="bg-primary-900 text-white p-6 sticky top-0 z-10">
        <h2 class="text-xl font-light">Lupa <span class="font-semibold">Ecoart</span></h2>
        {subtitle && <p class="text-sm text-primary-300">{subtitle}</p>}
    </div>

    <!-- Buscador mobile -->
    <div class="px-4 pt-4">
        <div class="relative">
            <input
                type="text"
                data-search
                enterkeyhint="search"
                aria-label="Buscar"
                placeholder="Buscar obras y objetos..."
                class="w-full pl-10 pr-4 py-2.5 bg-white/15 text-white placeholder-white/70 border border-white/25 rounded-full focus:outline-none focus:ring-2 focus:ring-primary-300"
            />
            <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-5 w-5 absolute left-3 top-1/2 -translate-y-1/2 text-white/70"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
        </div>
    </div>

    {
        categories && (
            <>
                <div class="p-4">
                    <h3 class="text-xs uppercase text-primary-300 font-semibold mb-3 tracking-wider px-3">
                        Categorías
                    </h3>
                    {Object.entries(WC_CATEGORIES).map(([slug, nombre]) => (
                        <a
                            href={`productos?cat=${slug}`}
                            class="flex items-center px-3 py-3 hover:bg-primary-700 rounded-xl transition"
                        >
                            <span class="font-medium text-white">{nombre}</span>
                        </a>
                    ))}
                </div>
                <div class="border-t border-primary-700 mx-4" />
            </>
        )
    }

    <!-- Links principales -->
    <div class="p-4">
        <a href="./" class="flex items-center px-3 py-3 hover:bg-primary-700 rounded-xl transition">
            <span class="font-medium text-white">Inicio</span>
        </a>
        <a href="productos" class="flex items-center px-3 py-3 hover:bg-primary-700 rounded-xl transition">
            <span class="font-medium text-white">Catálogo</span>
        </a>
        <a href="carrito" class="flex items-center px-3 py-3 hover:bg-primary-700 rounded-xl transition">
            <span class="font-medium text-white">Carrito</span>
            <span
                id="cart-count-drawer"
                class="ml-auto bg-white text-primary-800 text-xs font-bold px-2 py-1 rounded-full"
            >
                0
            </span>
        </a>
    </div>
</div>
