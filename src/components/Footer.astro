---
// ==========================================
// FOOTER — Lupa Ecoart
// ==========================================
const year = new Date().getFullYear();
---

<footer class="bg-primary-900 text-white">
    <div
        class="container mx-auto px-4 py-10 flex flex-col md:flex-row items-center justify-between gap-6"
    >
        <a href="./" class="flex items-center gap-2">
            <img src="/assets/logo.svg" alt="" class="h-8 w-8" />
            <span class="text-lg font-light tracking-wide">
                Lupa <span class="font-semibold">Ecoart</span>
            </span>
        </a>
        <div class="flex items-center gap-6 text-sm text-white/85">
            <a href="productos" class="hover:text-white transition">Catálogo</a>
            <a href="carrito" class="hover:text-white transition">Carrito</a>
            <a href="#nosotros" class="hover:text-white transition">Filosofía</a>
        </div>
        <p class="text-xs text-primary-300">© {year} Lupa Ecoart</p>
    </div>
</footer>
