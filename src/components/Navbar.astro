---
// ==========================================
// NAVBAR DESKTOP — Lupa Ecoart
// ==========================================
// Solo visible en >= md. En mobile la navegacion vive en <Drawer />.
interface Props {
    /** Seccion activa: se pinta con el fondo oliva oscuro. */
    active?: 'inicio' | 'catalogo' | 'carrito' | null;
}

const { active = null } = Astro.props;

const linkBase = 'px-4 py-2 rounded-full text-white font-medium transition whitespace-nowrap';
const linkOn = 'bg-primary-700';
const linkOff = 'hover:bg-primary-600';
---

<nav
    id="navbar-scroll"
    class="hidden md:block fixed top-0 left-0 right-0 bg-primary-500/95 backdrop-blur-sm shadow-lg z-50 transform transition-transform duration-300 ease-in-out"
>
    <!-- Buscador centrado absoluto -->
    <div
        class="absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2 w-full max-w-md px-4 z-10 pointer-events-none"
    >
        <div class="relative">
            <input
                type="text"
                id="search-input"
                data-search
                placeholder="Buscar obras y objetos..."
                class="pointer-events-auto w-full pl-10 pr-4 py-2 bg-white/20 text-white placeholder-white/80 border border-white/30 rounded-full focus:outline-none focus:ring-2 focus:ring-primary-300 focus:border-transparent"
            />
            <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-5 w-5 absolute left-3 top-1/2 -translate-y-1/2 text-white/80"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z"></path>
            </svg>
        </div>
    </div>

    <!-- Contenedor flex normal -->
    <div class="flex items-center justify-between px-6 py-3 relative">
        <!-- Marca + navegacion (izquierda) -->
        <div class="flex items-center gap-2 shrink-0">
            <a href="./" class="hidden xl:flex items-center gap-2 mr-4 text-white">
                <img src="/assets/logo.svg" alt="" class="h-8 w-8" />
                <span class="text-lg font-light tracking-wide">
                    Lupa <span class="font-semibold">Ecoart</span>
                </span>
            </a>
            <a href="./" class={`${linkBase} ${active === 'inicio' ? linkOn : linkOff}`}>Inicio</a>
            <a href="productos" class={`${linkBase} ${active === 'catalogo' ? linkOn : linkOff}`}>
                Catálogo
            </a>
        </div>

        <!-- Spacer invisible para que el carrito se mantenga a la derecha -->
        <div class="w-10 shrink-0"></div>

        <!-- Carrito (derecha) -->
        <a
            href="carrito"
            class={`relative p-2 rounded-full transition shrink-0 block ${
                active === 'carrito' ? 'bg-primary-700' : 'hover:bg-primary-600'
            }`}
            aria-label="Carrito"
        >
            <svg
                xmlns="http://www.w3.org/2000/svg"
                class="h-6 w-6 text-white"
                fill="none"
                viewBox="0 0 24 24"
                stroke="currentColor"
            >
                <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="1.8"
                    d="M15.75 10.5V6a3.75 3.75 0 10-7.5 0v4.5m11.356-1.993l1.263 12c.07.665-.45 1.243-1.119 1.243H4.25a1.125 1.125 0 01-1.12-1.243l1.264-12A1.125 1.125 0 015.513 7.5h12.974c.576 0 1.059.435 1.119 1.007z"
                ></path>
            </svg>
            <span
                id="cart-count-nav"
                class="absolute -top-0.5 -right-0.5 bg-white text-primary-800 text-xs rounded-full h-5 w-5 flex items-center justify-center font-bold"
            >
                0
            </span>
        </a>
    </div>
</nav>
