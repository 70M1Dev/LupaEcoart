---
// ==========================================
// BOTON HAMBURGUESA (mobile) — Lupa Ecoart
// ==========================================
// Abre y cierra el <Drawer />. La logica vive en src/scripts/ui.js.
// `class` permite posicionarlo distinto segun la pagina: en el home va dentro
// del hero (absolute), en el resto flota sobre la pagina (fixed).
interface Props {
    class?: string;
}

const {
    class:
        className = 'md:hidden fixed top-4 right-4 bg-primary-800/90 backdrop-blur-xs text-white p-2 rounded-full transition z-50'
} = Astro.props;
---

<button id="menu-toggle" class={className} aria-label="Menú">
    <svg
        id="icon-hamburger"
        xmlns="http://www.w3.org/2000/svg"
        class="h-6 w-6"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
    >
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
    </svg>
    <svg
        id="icon-close"
        xmlns="http://www.w3.org/2000/svg"
        class="h-6 w-6 hidden"
        fill="none"
        viewBox="0 0 24 24"
        stroke="currentColor"
    >
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
    </svg>
</button>
