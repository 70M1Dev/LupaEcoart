# ==========================================
# CONFIGURACION LOCAL — Template
# ==========================================
# Copia este archivo como .env y completa con los datos de tu WooCommerce
# local (LocalWP):
#
#   cp .env.example .env
#
# .env esta en .gitignore y NUNCA se sube a GitHub. Todo lo que empieza con
# PUBLIC_ termina en el bundle que ve el navegador, asi que nunca pongas aca
# keys de produccion: son solo para el WordPress local.
# ==========================================

# Vacio = pegarle directo a WordPress en vez de pasar por el Worker.
PUBLIC_WC_PROXY_URL=

# URL del sitio en LocalWP
PUBLIC_WC_URL=https://lupaecoart.local

# Claves de la REST API de WooCommerce (permisos de solo lectura)
PUBLIC_WC_CONSUMER_KEY=ck_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PUBLIC_WC_CONSUMER_SECRET=cs_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# WhatsApp de la tienda (solo digitos, con codigo de pais, sin + ni espacios)
# PUBLIC_WC_WHATSAPP=59894319604
